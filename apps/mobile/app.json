{
  "expo": {
    "name": "Umbil",
    "slug": "umbil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "umbil",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.umbil.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:umbil.ai",
        "applinks:www.umbil.ai"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.umbil.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#1fb8cd",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "umbil.ai",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "umbil"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/umbil-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#f7f8fa"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Umbil uses your microphone to let you dictate clinical questions instead of typing them.",
          "speechRecognitionPermission": "Umbil uses speech recognition to transcribe your dictated clinical questions into text.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {}
  }
}
