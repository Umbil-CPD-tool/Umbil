# Copy this file to `.env` in the same folder and fill in real values.
# Never commit `.env` — keep secrets and local overrides off git.
#
# EXPO_PUBLIC_SUPABASE_ANON_KEY is the public publishable (anon) key from
# the Supabase dashboard. Do not use the service_role secret.
#
# For store / production builds, EXPO_PUBLIC_API_URL must be https://umbil.ai
# (not localhost). Local Metro can still point at a local Next.js server.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_URL=https://umbil.ai
